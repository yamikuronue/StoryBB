# Copy to .env and adjust as needed:
#   cp .env.example .env

# Published host port for the forum container
STORYBB_HOST_PORT=8787

# Public URL of the forum (no trailing slash). Must match the URL browsers use
# (your DigitalOcean droplet/app domain, or http://localhost:8787 locally).
STORYBB_BOARDURL=https://forum.example.com
STORYBB_FORUM_NAME=StoryBB

# --- Droplet overlay (docker-compose.droplet.yml) ---
# Hostname Caddy requests a TLS certificate for (DNS must point at the droplet).
STORYBB_DOMAIN=forum.example.com
# Block Storage mount point holding uploads, Settings.php and Caddy certs.
STORYBB_DATA_DIR=/mnt/storybb

# Max concurrent Apache/PHP workers (~25-40 MB each). 20 suits a 1 GB droplet.
STORYBB_MAX_WORKERS=20
STORYBB_LANGUAGE=en-us

# --- Database ---
# DigitalOcean Managed MySQL (or MySQL on another droplet): use the host DO gives you.
# Example: STORYBB_DB_SERVER=db-mysql-nyc3-12345-do-user-xxxxx-0.g.db.ondigitalocean.com
# For local Compose with MariaDB: use docker-compose.local.yml and STORYBB_DB_SERVER=db
STORYBB_DB_SERVER=db-mysql-nyc3-XXXXX-do-user-XXXXX-0.g.db.ondigitalocean.com
STORYBB_DB_PORT=25060
STORYBB_DB_NAME=storybb
STORYBB_DB_USER=storybb
STORYBB_DB_PASSWD=replace-me
STORYBB_DB_PREFIX=sbb_

# Only used by docker-compose.local.yml
MYSQL_ROOT_PASSWORD=storybb_root

# First administrator account (created on first boot only)
STORYBB_ADMIN_USERNAME=admin
STORYBB_ADMIN_PASSWORD=replace-me-with-a-strong-password
STORYBB_ADMIN_EMAIL=admin@example.com
STORYBB_SERVER_EMAIL=noreply@example.com

# Optional; generated randomly on first install if empty
STORYBB_IMAGE_PROXY_SECRET=

# Set to 1 to rewrite Settings.php from env on every start
STORYBB_FORCE_RECONFIG=0

# Set to 1 to drop/recreate the DB and reinstall (destructive)
STORYBB_FORCE_REINSTALL=0
